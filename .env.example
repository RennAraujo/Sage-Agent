# Copie para .env (ignorado pelo git) e preencha. Nunca commite o .env.
# Para os testes que chamam o Bedrock real, exporte SAGE_BEDROCK_IT=true no shell
# (é flag de teste, não vai neste arquivo).

# Criptografia: local (arquivo gerado por scripts/generate-local-key) ou kms.
SAGE_CRYPTO_PROVIDER=local
SAGE_CRYPTO_LOCAL_KEY_FILE=secrets/local-master.key
# Só com SAGE_CRYPTO_PROVIDER=kms: id, ARN ou alias da chave. Região e credenciais vêm do ambiente AWS padrão.
SAGE_KMS_KEY_ID=

# Modelos de linguagem no Bedrock (model id ou inference profile habilitado na conta). Sem eles /api/perguntas dá 503.
SAGE_MODEL_FAST_ID=
SAGE_MODEL_STRONG_ID=
# Região do Bedrock; credenciais vêm da cadeia padrão da AWS.
AWS_REGION=us-east-1
